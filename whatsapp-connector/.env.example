# =====================================================================
# WhatsApp Connector - Backend Environment Variables
# Copy this file to .env (e.g. `cp .env.example .env`) and fill in values.
# NEVER commit your real .env file with secrets to Git.
# =====================================================================

# ----------------- AI Assistant & Gemini Credentials -----------------
# Required for WhatsApp AI Assistant, Executive Summaries, and Analytics
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model for assistant and summaries (default: gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# Fallback model if primary exceeds rate limits or fails (default: gemini-flash-latest)
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Model parameters
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=1200

# ----------------- Server & Network Configuration -----------------
# Port to bind backend Express server (default: 3000)
PORT=3000

# Host interface to listen on (default: 0.0.0.0 for dual-stack IPv4/IPv6 support)
HOST=0.0.0.0

# Base URL used for external links (default: http://localhost:3000)
BASE_URL=http://localhost:3000

# ----------------- Security & Access Tokens -----------------
# Optional local API authentication key protecting /api/* and /mcp
# Leave empty for open local development; set a strong token in production
API_KEY=

# Tunnel guard: rejects requests through tunnels/proxies unless it is /mcp/<token>
# Values: on | off (default: on)
TUNNEL_GUARD=on

# Path to the temporary MCP tokens store (default: ./tokens.json)
TOKENS_FILE=./tokens.json

# ----------------- Storage & State Paths -----------------
# Path to WhatsApp Baileys multi-file authentication state
AUTH_DIR=./auth_info

# Path to local JSON database storage (messages, contacts, chats, groups)
DATA_DIR=./data
